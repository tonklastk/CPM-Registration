# Copy this file to .streamlit/secrets.toml and fill in the PostgreSQL/SMTP values.

[database]
host = "localhost"
port = 5432
database = "plant_access"
user = "plant_access_app"
password = "YOUR_POSTGRES_PASSWORD"
sslmode = "prefer"
connect_timeout = 10

[smtp]
host = "smtp.gmail.com"
port = 465
username = "YOUR_FACILITY_EMAIL@gmail.com"
password = "YOUR_GMAIL_APP_PASSWORD"
from_name = "Chulabhorn Pharmaceutical Manufacturing Facility"

[auth]
# Existing administrator hash can be retained from your working package.
admin_password_hash = "pbkdf2$REPLACE_WITH_HASH"

[auth.approver1]
email = "app1@plant.com"
password_hash = "pbkdf2$REPLACE_WITH_HASH"

[auth.approver2]
email = "app2@plant.com"
password_hash = "pbkdf2$REPLACE_WITH_HASH"

[auth.final_approver]
email = "final@plant.com"
password_hash = "pbkdf2$REPLACE_WITH_HASH"
